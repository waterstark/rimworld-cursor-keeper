<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CursorKeeper</AssemblyName>
    <RootNamespace>CursorKeeper</RootNamespace>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <OutputPath>../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <!-- Reference-only packages: nothing from them is copied to the output,
       and no RimWorld install is needed to build. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
